# Build output. `go build ./...` writes each main package's binary into the
# working directory, named after its directory — so building from the repo root
# drops examples/minimal's binary here as ./minimal. `make build` avoids this by
# writing to /dev/null, and CI fails on any committed file over 1 MiB.
/bin/
/minimal
*.test
*.out

# Anything that could hold a real credential. keel never reads a .env of its
# own; config.Load reads one only when a service asks it to.
.env
.env.*
*.pem
*.p8
*.p12
*.key

# Editors and OS
.idea/
.vscode/
.DS_Store
